# STAMPER_TSLR Environment Configuration
# Copy this file to .env and customize for your environment

# ==========================================
# ENVIRONMENT
# ==========================================
ENVIRONMENT=development          # development, staging, production
DEBUG=true
SECRET_KEY=your-super-secret-key-change-in-production-min-32-chars

# ==========================================
# MODEL CONFIGURATION
# ==========================================
# IsolationForest
MODEL__ISO_CONTAMINATION=0.05
MODEL__ISO_N_ESTIMATORS=100
MODEL__ISO_MAX_SAMPLES=auto
MODEL__ISO_RANDOM_STATE=42

# RandomForest (supervised adaptation)
MODEL__RF_N_ESTIMATORS=100
MODEL__RF_MAX_DEPTH=10
MODEL__RF_MIN_SAMPLES_SPLIT=5
MODEL__RF_MIN_SAMPLES_LEAF=2
MODEL__RF_RANDOM_STATE=42

# Ensemble
MODEL__ENSEMBLE_ENABLED=true
MODEL__ENSEMBLE_VOTING=soft
# MODEL__ENSEMBLE_WEIGHTS=[0.3, 0.2, 0.2, 0.1, 0.2]  # Optional custom weights

# Uncertainty Quantification
MODEL__UNCERTAINTY_METHOD=ensemble        # ensemble, conformal, bayesian
MODEL__EPISTEMIC_SAMPLES=10
MODEL__CONFORMAL_CALIBRATION_SIZE=500
MODEL__CONFIDENCE_THRESHOLD=0.70

# Drift Detection
MODEL__DRIFT_ENABLED=true
MODEL__DRIFT_WINDOW_SIZE=100
MODEL__DRIFT_SENSITIVITY=0.05
MODEL__DRIFT_MIN_SAMPLES=50
MODEL__RETRAIN_ON_DRIFT=true
MODEL__RETRAIN_MIN_SAMPLES=200

# Human Feedback
MODEL__FEEDBACK_BATCH_SIZE=5
MODEL__FEEDBACK_MAX_BUFFER=1000

# ==========================================
# DATA CONFIGURATION
# ==========================================
DATA__SENSOR_FEATURES=["temperature", "pressure", "vibration"]
DATA__SENSOR_MISSING_PROB=0.25

# Multimodal (Phase 3)
DATA__MULTIMODAL_ENABLED=false
DATA__MAX_SEQUENCE_LENGTH=100
DATA__TEXT_MAX_LENGTH=512
DATA__IMAGE_SIZE=[224, 224]

# Encoders
DATA__TEXT_ENCODER_MODEL=sentence-transformers/all-MiniLM-L6-v2
DATA__IMAGE_ENCODER_MODEL=resnet50
DATA__TIMESERIES_ENCODER=patchtst

# Fusion
DATA__FUSION_STRATEGY=late              # early, late, cross_attention
DATA__FUSION_HIDDEN_DIM=256

# ==========================================
# API CONFIGURATION
# ==========================================
API__HOST=0.0.0.0
API__PORT=8000
API__WORKERS=4
API__RELOAD=true

# CORS
API__CORS_ORIGINS=["*"]
API__CORS_CREDENTIALS=true

# Rate Limiting
API__RATE_LIMIT_ENABLED=false
API__RATE_LIMIT_REQUESTS=100
API__RATE_LIMIT_WINDOW=60

# WebSocket
API__WS_ENABLED=true
API__WS_HEARTBEAT_INTERVAL=30
API__WS_MAX_CONNECTIONS=1000

# API Versioning
API__API_VERSION=v1
API__API_PREFIX=/api

# ==========================================
# MONITORING CONFIGURATION
# ==========================================
# Logging
MONITORING__LOG_LEVEL=INFO              # DEBUG, INFO, WARNING, ERROR
MONITORING__LOG_FORMAT=json             # json, text
# MONITORING__LOG_FILE=./logs/app.log    # Optional: log to file
MONITORING__CORRELATION_ID_HEADER=X-Correlation-ID

# Prometheus Metrics
MONITORING__METRICS_ENABLED=true
MONITORING__METRICS_PORT=9090
MONITORING__METRICS_PATH=/metrics

# OpenTelemetry Tracing
MONITORING__TRACING_ENABLED=false
# MONITORING__TRACING_ENDPOINT=http://jaeger:4317
MONITORING__TRACING_SERVICE_NAME=stamper-tslr
MONITORING__TRACING_SAMPLE_RATE=0.1

# Health Checks
MONITORING__HEALTH_CHECK_INTERVAL=30
MONITORING__DEPENDENCY_TIMEOUT=5.0

# ==========================================
# STORAGE CONFIGURATION
# ==========================================
# Database (SQLite for dev, PostgreSQL for prod)
STORAGE__DATABASE_URL=sqlite:///./stamper_tslr.db
# STORAGE__DATABASE_URL=postgresql://user:pass@localhost:5432/stamper_tslr
STORAGE__DATABASE_POOL_SIZE=10
STORAGE__DATABASE_MAX_OVERFLOW=20
STORAGE__DATABASE_ECHO=false

# Redis
STORAGE__REDIS_URL=redis://localhost:6379/0
STORAGE__REDIS_MAX_CONNECTIONS=50
STORAGE__REDIS_SOCKET_TIMEOUT=5.0

# Object Storage (Model Artifacts)
STORAGE__STORAGE_BACKEND=local          # local, s3, minio
STORAGE__STORAGE_LOCAL_PATH=./models
# STORAGE__STORAGE_S3_BUCKET=stamper-tslr-models
# STORAGE__STORAGE_S3_REGION=us-east-1
# STORAGE__STORAGE_S3_ENDPOINT=http://localhost:9000  # For MinIO

# ==========================================
# FRONTEND CONFIGURATION
# ==========================================
FRONTEND__DEV_SERVER_PORT=5173
FRONTEND__DEV_SERVER_HOST=localhost
FRONTEND__API_BASE_URL=http://localhost:8000
FRONTEND__WS_BASE_URL=ws://localhost:8000

# ==========================================
# OPTIONAL: YAML CONFIG FILE PATH
# ==========================================
# STAMPER_CONFIG_PATH=./config.yaml